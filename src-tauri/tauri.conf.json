{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TORI Download Manager",
  "version": "2.0.0",
  "identifier": "com.tori.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TORI Download Manager",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 540,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../resources/bin/ffprobe.exe": "bin/ffprobe.exe",
      "../resources/bin/yt-dlp.exe": "bin/yt-dlp.exe",
      "../resources/bin/tdm-native-host.exe": "bin/tdm-native-host.exe",
      "../resources/bin/tdm-cli.exe": "bin/tdm-cli.exe",
      "../resources/LICENSE-THIRD-PARTY.txt": "LICENSE-THIRD-PARTY.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "TORI Download Manager"
      }
    }
  }
}